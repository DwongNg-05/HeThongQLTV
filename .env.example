# ASP.NET Core reads environment variables; it does NOT auto-load this file.
# Example PowerShell: $env:LibraryRules__MaxLoans = "5"
ASPNETCORE_ENVIRONMENT=Development
ASPNETCORE_URLS=http://localhost:5256
ConnectionStrings__Library=Data Source=database/library.db
LibraryRules__MaxLoans=5
LibraryRules__LoanDays=14
LibraryRules__RenewalDays=7
LibraryRules__MaxRenewals=2
LibraryRules__FinePerDay=2000
SeedDemo=false

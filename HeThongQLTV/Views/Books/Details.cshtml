@model Book
@{ViewData["Title"]="Chi tiết sách";}
<a class="back" href="/Books">← Trở lại danh mục</a><div class="detail panel"><div class="detail-cover"><div class="book-cover" style="--cover:@Model.Color"><small>@Model.Author</small><strong>@Model.Title</strong><span>✦</span><em>LÁ LIBRARY</em></div></div><div><span class="category">@Model.Category</span><h1>@Model.Title</h1><p class="muted">@Model.Author</p><span class="badge @(Model.Available==0?"danger":"")">@Model.Available / @Model.Quantity bản còn sẵn</span><dl><dt>Mã sách</dt><dd>S@(Model.Id.ToString("0000"))</dd><dt>Nhà xuất bản</dt><dd>@Model.Publisher</dd><dt>Năm xuất bản</dt><dd>@Model.Year</dd><dt>Vị trí kệ</dt><dd>@Model.Shelf</dd><dt>ISBN</dt><dd>@(string.IsNullOrEmpty(Model.Isbn)?"Chưa cập nhật":Model.Isbn)</dd></dl><h3>Giới thiệu sách</h3><p class="description">@Model.Description</p><div class="actions">@if(User.IsInRole("DocGia")){<a asp-controller="Reservations" asp-action="Create" asp-route-bookId="@Model.Id" class="btn primary">Đặt trước sách</a><p class="muted">@(Model.Available > 0 ? "Sách còn sẵn. Bạn có thể đặt trước và đến quầy nhận sách theo thứ tự đăng ký." : "Sách đã hết bản sẵn có. Đặt trước để vào hàng chờ khi có sách trả lại.")</p>}else{<a class="btn primary" href="/Books/Edit/@Model.Id">Chỉnh sửa sách</a><form asp-action="Delete" asp-route-id="@Model.Id" method="post" data-confirm="Xóa đầu sách này? Chỉ sách chưa có lịch sử giao dịch mới được xóa."><button class="btn destructive">Xóa sách</button></form>}</div></div></div>

@using System.Security.Claims
@model List<AppUser>
@{
    ViewData["Title"] = "Tài khoản & phân quyền";
    var currentUserId = User.FindFirstValue(ClaimTypes.NameIdentifier);
}
<div class="page-head">
    <div>
        <div class="eyebrow">QUẢN TRỊ HỆ THỐNG</div>
        <h1>Tài khoản & phân quyền</h1>
        <p>Kiểm soát quyền truy cập cho từng người dùng.</p>
    </div>
    <a class="btn primary" href="/Users/Edit">＋ Thêm tài khoản</a>
</div>
<section class="panel">
    <div class="table-wrap">
        <table>
            <thead>
                <tr><th>NGƯỜI DÙNG</th><th>TÊN ĐĂNG NHẬP</th><th>VAI TRÒ</th><th>THẺ ĐỘC GIẢ</th><th>TRẠNG THÁI</th><th>THAO TÁC</th></tr>
            </thead>
            <tbody>
                @foreach (var u in Model)
                {
                    <tr>
                        <td><b>@u.FullName</b></td>
                        <td>@u.Username</td>
                        <td>@(u.Role == "Admin" ? "Quản trị viên" : u.Role == "ThuThu" ? "Thủ thư" : "Độc giả")</td>
                        <td>@(u.Member?.FullName ?? "—")</td>
                        <td><span class="badge @(!u.Active ? "danger" : "")">@(u.Active ? "Hoạt động" : "Đã khóa")</span></td>
                        <td>
                            <a class="text-link" href="/Users/Edit/@u.Id">Chỉnh sửa →</a>
                            @if (u.Id.ToString() == currentUserId)
                            {
                                <span class="badge">Đang sử dụng</span>
                            }
                            else
                            {
                                <form asp-action="SetActive" asp-route-id="@u.Id" method="post"
                                      data-confirm="@(u.Active ? $"Khóa tài khoản {u.Username}? Người dùng sẽ không thể tiếp tục truy cập." : $"Mở khóa tài khoản {u.Username}?")"
                                      onsubmit="return confirm(this.dataset.confirm)">
                                    <input type="hidden" name="active" value="@(u.Active ? "false" : "true")" />
                                    <button type="submit" class="btn @(u.Active ? "" : "primary")">@(u.Active ? "Khóa tài khoản" : "Mở khóa")</button>
                                </form>
                            }
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
</section>
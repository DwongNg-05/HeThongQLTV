@model List<Reservation>
@{
    ViewData["Title"] = "Đặt trước sách";
    bool staff = User.IsInRole("Admin") || User.IsInRole("ThuThu");
}
<div class="page-head">
    <div><div class="eyebrow">HẸN VỚI MỘT CUỐN SÁCH</div><h1>Đặt trước sách</h1>
        <p>@(staff ? "Xác nhận khi giao sách để lập phiếu mượn. Có thể xóa yêu cầu đã hủy hoặc đã nhận." : "Yêu cầu được phục vụ theo thứ tự đăng ký khi có bản sách sẵn có.")</p>
    </div>
    <div class="actions">
        @if (User.IsInRole("DocGia")) { <a class="btn primary" asp-action="Create">Đặt trước sách online</a> }
        <a class="btn" href="/Books">Xem danh mục →</a>
    </div>
</div>
<section class="panel"><div class="table-wrap"><table>
    <thead><tr><th>MÃ</th><th>SÁCH</th><th>SỐ LƯỢNG</th><th>ĐỘC GIẢ</th><th>NGÀY ĐẶT</th><th>TRẠNG THÁI</th><th>THAO TÁC</th></tr></thead>
    <tbody>
        @foreach (var group in Model.GroupBy(r => new { r.BookId, r.MemberId, r.CreatedAt, r.Status }))
        {
            var r = group.First();
            <tr>
                <td>DT@(r.Id.ToString("0000"))</td>
                <td><b>@r.Book.Title</b>@if (r.Status == "Đang chờ") { <small>Còn @r.Book.Available bản; nhận theo thứ tự đăng ký</small> }</td>
                <td>@group.Count() quyển</td><td>@r.Member.FullName</td><td>@r.CreatedAt.ToString("dd/MM/yyyy HH:mm")</td>
                <td><span class="badge @(r.Status == "Đang chờ" ? "" : "neutral")">@r.Status</span></td>
                <td><div class="actions wrap">
                    @if (r.Status == "Đang chờ")
                    {
                        @if (staff)
                        {
                            <form asp-action="Confirm" asp-route-id="@r.Id" method="post" data-confirm="Xác nhận giao @group.Count() quyển sách cho @r.Member.FullName và lập phiếu mượn?">
                                <button type="submit" class="mini-btn">Xác nhận đặt trước</button>
                            </form>
                        }
                        <form asp-action="Cancel" asp-route-id="@r.Id" method="post" data-confirm="Hủy yêu cầu đặt trước @group.Count() quyển sách này?">
                            <button type="submit" class="text-button danger-text">Hủy đặt trước</button>
                        </form>
                    }
                    else if (staff && (r.Status == "Đã hủy" || r.Status == "Đã nhận"))
                    {
                        <form asp-action="Delete" asp-route-id="@r.Id" method="post" data-confirm="Xóa vĩnh viễn yêu cầu đặt trước này khỏi danh sách? Phiếu mượn và lịch sử trả sách vẫn được giữ lại.">
                            <button type="submit" class="text-button danger-text">Xóa</button>
                        </form>
                    }
                </div></td>
            </tr>
        }
    </tbody>
</table>
@if (Model.Count == 0)
{
    <div class="empty"><span class="empty-icon">◷</span><h2>Chưa có yêu cầu đặt trước</h2><p>@(staff ? "Yêu cầu của độc giả sẽ xuất hiện tại đây." : "Bạn có thể đặt trước sách tại danh mục hoặc chọn Đặt trước sách online.")</p></div>
}
</div></section>
